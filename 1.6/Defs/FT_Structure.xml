	<ThingDef ParentName="FT_CargoContainer_Base">
		<defName>FT_RefrigeratedContainer</defName>
		<label>refrigerated container</label>
		<description>a refrigerated cargo container that uses the selected resource as its building material. it needs power; without it the container rots like the selected resource unless the surrounding temperature preserves it, and the contents are not dropped.</description>
		<designationCategory>Misc</designationCategory>
		<tickerType>Rare</tickerType>
		<defaultStuff>RawRice</defaultStuff>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<graphicData>
			<texPath>Things/ContainerBasic/Container</texPath>
			<graphicClass>CargoContainersExpanded.Graphic_RefrigeratedContainer</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(4.3,4.3)</drawSize>
		</graphicData>
		<stuffCategories>
			<li>FT_CargoContainerRefrigeratedStuff</li>
		</stuffCategories>
		<costList>
			<Steel>60</Steel>
		</costList>
		<costStuffCount>1200</costStuffCount>
		<size>(4,2)</size>
		<statBases>
			<MaxHitPoints>2500</MaxHitPoints>
			<DeteriorationRate>0</DeteriorationRate>
			<WorkToBuild>500</WorkToBuild>
		</statBases>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>200</basePowerConsumption>
			</li>
			<li Class="CargoContainersExpanded.CompProperties_RefrigeratedContainer" />
		</comps>
	</ThingDef>

