<Defs>

	<TipSetDef>
    <defName>CargoContainer_Tips</defName>
		<tips>
			<li>Interstellar Organization for Standardization (ISO) is composed of multiple interplanetary companies.</li>
			<li>The ISO cargo container size is formulated by the Interstellar Organization for Standardization (ISO) mainly because their cargoship is widely used by companies and nations in coreworld and midworld.</li>
			<li>Interstellar Industries Complex of Nara (IICN)is a Interstellar industrial organization all over themidworld and rimworld,their development is aimed at expanding the living space of humanity in any possible.</li>
		</tips>
	</TipSetDef>

	<ThingDef ParentName="BuildingBase" Name="FT_CargoContainer_Base" Abstract="True">
		<thingClass>Building</thingClass>
		<category>Building</category>
		<blockLight>false</blockLight>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<fillPercent>1</fillPercent>
		<coversFloor>false</coversFloor>
		<holdsRoof>false</holdsRoof>
		<castEdgeShadows>true</castEdgeShadows>
		<tickerType>Never</tickerType>    
		<canOverlapZones>false</canOverlapZones>
		<researchPrerequisites>
			<li>Machining</li>
		</researchPrerequisites>
		<pathCostIgnoreRepeat>false</pathCostIgnoreRepeat>	
		<resourcesFractionWhenDeconstructed>1.00</resourcesFractionWhenDeconstructed>
		<building>
			<allowAutoroof>false</allowAutoroof>
			<ai_chillDestination>false</ai_chillDestination>
			<expandHomeArea>false</expandHomeArea>	
			<isInert>true</isInert>
		</building>
		<statBases>
			<MarketValue>2500</MarketValue>
			<Beauty>5</Beauty>
			<Flammability>0.0</Flammability>
		</statBases>
		<filthLeaving>Filth_RubbleBuilding</filthLeaving>
		<rotatable>true</rotatable>
		<selectable>true</selectable>
		<neverMultiSelect>true</neverMultiSelect>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Misc</designationCategory>
		<repairEffect>ConstructMetal</repairEffect>
	</ThingDef>	
	
	<ThingDef ParentName="FT_CargoContainer_Base">
		<defName>FT_CargoContainer</defName>
		<label>resource container</label>
		<description>a cargo container that can safely store your resources,stuff won't vanish when deconstructed.</description>
		<graphicData>
			<texPath>Things/ContainerBasic/Container</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(4.3,4.3)</drawSize>
		</graphicData>
		<costList>
			<Steel>60</Steel>
		</costList>
		<costStuffCount>1200</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<size>(4,2)</size>
		<statBases>
			<MarketValue>2000</MarketValue>
			<MaxHitPoints>2500</MaxHitPoints>
			<WorkToBuild>500</WorkToBuild>
		</statBases>
	</ThingDef>	
	
